# Copy this file to .env for local development.
# In production (DigitalOcean App Platform, etc.), set these as
# encrypted environment variables in the hosting dashboard instead
# of committing a .env file.

PORT=3000

# Credentials required to view the DM site at /dm.
# Change DM_PASSWORD to something only your table's DM knows —
# this is what keeps players out of the stat blocks and the twist.
DM_USERNAME=dm
DM_PASSWORD=change-me-before-deploying
